{
  "host": "127.0.0.1",
  "port": 32145,
  "tokenFile": "../workspace/.potassium-mcp-token",
  "requestTimeoutMs": 15000,
  "maxMessageBytes": 1048576,
  "maxPendingRequests": 64,
  "shutdownGraceMs": 5000,
  "artifactRoots": [
    {
      "name": "artifacts",
      "path": "../workspace/potassium-mcp-artifacts",
      "recursive": true,
      "extensions": [".json", ".ndjson", ".txt", ".log"]
    }
  ],
  "httpAllowedHosts": [
    "apis.roblox.com",
    "games.roblox.com",
    "thumbnails.roblox.com",
    "users.roblox.com"
  ]
}
